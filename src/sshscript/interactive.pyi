from typing import Any, Callable, Literal, TextIO
from dataclasses import dataclass
from .session import Session
from .commandjob import JobResult, CommandJob
from .commandresult import CommandResult

ConsoleState = Literal['ready', 'incomplete', 'running', 'waiting_input', 'completed', 'failed', 'closed']
SessionReuse = Literal['in_use', 'confirmed', 'unknown', 'closed']
class CredentialsRequiredError(ValueError): ...
class ConsoleInitializationError(RuntimeError):
    session_reuse: str
class ConsoleCleanupError(RuntimeError):
    session_reuse: str
@dataclass(frozen=True)
class Environment:
    kind: str
    host: str
    connection_user: str | None
    effective_user: str
    identity_verified: bool
@dataclass(frozen=True)
class SwitchRequest:
    kind: str
    username: str | None
    environment: Environment
    credential_supplied: bool
@dataclass(frozen=True)
class SwitchCredentials:
    password: str | None
@dataclass(frozen=True)
class SwitchOutcome:
    request: SwitchRequest
    success: bool
    environment: Environment
    error_type: str | None = ...
@dataclass(frozen=True)
class ConsoleUpdate:
    state: ConsoleState
    stdout: str = ...
    stderr: str = ...
    result: CommandResult[int | None] | None = ...
    error_type: str | None = ...
    session_reuse: SessionReuse = ...
class Console:
    namespace: dict[str, Any]
    more: bool
    done: bool
    def __init__(self, session: Session, *, ownership: Literal['borrowed', 'owned'] = ..., terminal: bool = ..., get_pty: bool = ..., credential_resolver: Callable[[SwitchRequest], SwitchCredentials | None] | None = ..., switch_observer: Callable[[SwitchOutcome], None] | None = ..., stdout: TextIO | None = ..., stderr: TextIO | None = ..., input_func: Callable[[str], str] | None = ..., password_func: Callable[[str], str] | None = ...) -> None: ...
    @property
    def connection(self) -> Session: ...
    @property
    def environments(self) -> tuple[Environment, ...]: ...
    @property
    def session_reuse(self) -> SessionReuse: ...
    def submit(self, line: str) -> ConsoleUpdate: ...
    def start(self, command: str, *, timeout: float | None = ..., stop_timeout: float = ..., capture_limit: int = ..., check: bool = ...) -> CommandJob: ...
    def start_command(self, command: str, *, timeout: float | None = ..., stop_timeout: float = ..., capture_limit: int = ...) -> ConsoleUpdate: ...
    def poll(self) -> ConsoleUpdate: ...
    def send_input(self, text: str, *, newline: bool = ..., timeout: float = ...) -> ConsoleUpdate: ...
    def interrupt(self) -> ConsoleUpdate: ...
    def eof(self) -> ConsoleUpdate: ...
    def leave(self) -> ConsoleUpdate | None: ...
    def close(self) -> ConsoleUpdate: ...
    def shell(self, *args: Any, **kwargs: Any) -> None: ...
    def su(self, *args: Any, **kwargs: Any) -> None: ...
    def sudo(self, *args: Any, **kwargs: Any) -> None: ...
    def enter(self, *args: Any, **kwargs: Any) -> None: ...
    def connect(self, *args: Any, **kwargs: Any) -> None: ...
    def interact(self) -> None: ...
    def __enter__(self) -> Console: ...
    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> Literal[False]: ...
