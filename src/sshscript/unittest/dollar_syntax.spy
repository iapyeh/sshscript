"""Credential-free smoke tests for SSHScript's dollar syntax.

Run from the source directory with:

    python3 sshscript.py unittest/dollar_syntax.spy

All commands execute on localhost.  The suite does not load host configuration,
connect to SSH, or read credentials.
"""

import os
import shlex
import sys
import tempfile


passed = []


def case(name):
    print(f"\n[dollar syntax: {name}]", flush=True)


def done(name):
    passed.append(name)
    print(f"PASS: {name}", flush=True)


def test_command_forms():
    name = "bare, string, expression, and f-string commands"
    case(name)

    $python3 -c "print('bare-command')"
    assert $.stdout.strip() == "bare-command"
    assert $.stderr == ""
    assert $.exitcode == 0

    $'printf string-command'
    assert $.stdout == "string-command"

    $r'printf raw-command'
    assert $.stdout == "raw-command"

    dynamic_command = shlex.join(
        [sys.executable, "-c", "print('expression-command')"]
    )
    $(dynamic_command, shell=False)
    assert $.stdout.strip() == "expression-command"

    value = "f-string-command"
    $f'{shlex.quote(sys.executable)} -c "print(\'{value}\')"'
    assert $.stdout.strip() == value

    done(name)


def test_result_state_and_assignment():
    name = "assignment, stdout, stderr, and exit code"
    case(name)

    stdout, stderr = $python3 -c "import sys; print('out'); print('err', file=sys.stderr)"
    assert stdout.strip() == "out"
    assert stderr.strip() == "err"
    assert str($.stdout) == str(stdout)
    assert str($.stderr) == str(stderr)
    assert $.exitcode == 0

    $python3 -c "import sys; sys.exit(9)"
    assert $.stdout == ""
    assert $.stderr == ""
    assert $.exitcode == 9

    done(name)


def test_shell_features():
    name = "automatic shell operators and expansion"
    case(name)

    $printf 'alpha\nbeta\n' | grep beta
    assert $.stdout.strip() == "beta"
    assert $.exitcode == 0
    assert $.dollar.use_shell is True
    assert "pipeline" in $.dollar.shell_reasons

    $VALUE=expanded; printf '%s' "$VALUE"
    assert $.stdout == "expanded"
    assert "assignment" in $.dollar.shell_reasons

    $false || printf recovered
    assert $.stdout == "recovered"
    assert $.exitcode == 0
    assert "logical-operator" in $.dollar.shell_reasons

    done(name)


def test_redirection_in_temporary_directory():
    name = "redirection with automatic cleanup"
    case(name)

    with tempfile.TemporaryDirectory(prefix="sshscript-dollar-test-") as folder:
        output_path = os.path.join(folder, "output file.txt")
        quoted_path = shlex.quote(output_path)

        $f'printf "first\nsecond\n" > {quoted_path}'
        assert $.exitcode == 0
        assert "redirection" in $.dollar.shell_reasons

        $f'cat {quoted_path} | tail -n 1'
        assert $.stdout.strip() == "second"

    assert not os.path.exists(folder)
    done(name)


def test_explicit_execution_options():
    name = "string command validation and explicit shell options"
    case(name)

    argv = [
        sys.executable,
        "-c",
        "import sys; print(sys.argv[1:])",
        "|",
        "not-a-pipeline",
    ]
    $(shlex.join(argv), shell=False, timeout=10)
    assert $.stdout.strip() == "['|', 'not-a-pipeline']"
    assert $.dollar.use_shell is False

    for invalid_command in (argv, tuple(argv)):
        try:
            $(invalid_command, shell=False, timeout=10)
        except TypeError as exc:
            assert str(exc) == (
                f"command must be str, not {type(invalid_command).__name__}"
            )
        else:
            raise AssertionError(
                f"{type(invalid_command).__name__} command was accepted"
            )

    $("printf forced-shell", shell=True, timeout=10)
    assert $.stdout == "forced-shell"
    assert $.dollar.use_shell is True

    done(name)


def test_function_scope():
    name = "dollar commands inside Python functions"
    case(name)

    def run(command):
        stdout, stderr = $(command)
        return stdout.strip(), str(stderr), $.exitcode

    result = run(
        shlex.join([sys.executable, "-c", "print('function-command')"])
    )
    assert result == ("function-command", "", 0)

    done(name)


def test_session_context():
    name = "with-dollar persistent local shell"
    case(name)

    with $('bash') as console:
        $PERSISTED=inside-context
        $printf '%s' "$PERSISTED"
        assert $.stdout == "inside-context"
        assert console.exitcode == 0

    assert $.exitcode == 0
    done(name)


def test_spy_import():
    name = "imported spy module containing dollar syntax"
    case(name)

    import dollar_syntax_fixture

    assert dollar_syntax_fixture.FIXTURE_NAME == "dollar-syntax-fixture"
    result = dollar_syntax_fixture.run_fixture("imported-command")
    assert result == ("imported-command", "", 0)

    done(name)


TESTS = (
    test_command_forms,
    test_result_state_and_assignment,
    test_shell_features,
    test_redirection_in_temporary_directory,
    test_explicit_execution_options,
    test_function_scope,
    test_session_context,
    test_spy_import,
)


if __name__ == "__main__":
    for test in TESTS:
        test()

    assert len(passed) == len(TESTS), (len(passed), len(TESTS))
    print(
        f"\nAll {len(passed)} credential-free dollar syntax tests passed.",
        flush=True,
    )
